# Written by tools/deploy.sh: the GUID of this machine's iCUE install directory.
# Machine-specific, so it must not be shared between checkouts.
.widget-id

# Local secrets. Calendar feed URLs belong in the iCUE settings panel, never in the repo:
# a Google Calendar secret ICS address is a bearer credential for the whole calendar.
.env
.env.*
!.env.example
*.pem
*.key

# Scratch output from headless-browser layout checks. The committed reference renders
# live in docs/ and are deliberately not ignored.
/*.png
screenshots/
*.local.html

# Node, if tooling ever grows dependencies
node_modules/
npm-debug.log*
.npm/

# Editors and OS cruft
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
